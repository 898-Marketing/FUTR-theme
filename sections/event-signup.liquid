{%- comment -%}
  Event signup landing page section.

  Visitors enter their email; the customer form creates a Shopify customer
  with the tags in "Customer tags" (default: newsletter,november-2026-event).
  Downstream automations (customer segment, discount, Klaviyo flow) depend on
  the exact tag, so change it only when reusing this section for a new event.

  Used by templates/page.event-signup.json.
{%- endcomment -%}

{%- liquid
  assign event_tags = section.settings.customer_tags | strip
  if event_tags == blank
    assign event_tags = 'newsletter'
  endif
  assign event_form_id = 'event_signup_form_' | append: section.id
  assign logo_alt = section.settings.logo.alt | default: shop.name
  assign logo_sizes = '(min-width: 768px) ' | append: section.settings.logo_width | append: 'px, ' | append: section.settings.logo_width_mobile | append: 'px'

  assign discount_code = section.settings.discount_code | strip
  assign shop_redirect = section.settings.shop_link | default: routes.all_products_collection_url
  assign shop_url = shop_redirect
  if discount_code != blank
    comment
      /discount/CODE applies the code to the visitor's cart, then redirects.
    endcomment
    assign root_path = routes.root_url | append: '/' | replace: '//', '/'
    assign encoded_code = discount_code | url_encode
    assign shop_url = root_path | append: 'discount/' | append: encoded_code | append: '?redirect=' | append: shop_redirect
  endif
-%}

{%- capture event_success -%}
  <div class="event-signup__success" role="status" tabindex="-1" id="EventSignupSuccess-{{ section.id }}">
    {%- if section.settings.success_heading != blank -%}
      <h2 class="event-signup__success-heading">{{ section.settings.success_heading }}</h2>
    {%- endif -%}

    {%- if section.settings.success_message != blank -%}
      <p class="event-signup__success-text">{{ section.settings.success_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_code and discount_code != blank -%}
      <div class="event-signup__code-box">
        {%- if section.settings.code_label != blank -%}
          <span class="event-signup__code-label">{{ section.settings.code_label }}</span>
        {%- endif -%}
        <div class="event-signup__code-row">
          <span class="event-signup__code" data-event-code>{{ discount_code | escape }}</span>
          <button
            type="button"
            class="btn event-signup__copy"
            data-event-copy
            data-copied-text="{{ section.settings.copied_label | escape }}"
          >{{ section.settings.copy_label | escape }}</button>
        </div>
        <span class="visually-hidden" aria-live="polite" data-event-copy-status></span>
      </div>
    {%- endif -%}

    {%- if section.settings.shop_label != blank -%}
      <a class="btn event-signup__shop" href="{{ shop_url }}">{{ section.settings.shop_label | escape }}</a>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --event-text: {{ section.settings.text_color }};
    --event-bg: {{ section.settings.background_color }};
    --event-overlay: {{ section.settings.overlay_color }};
    --event-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --event-logo-width: {{ section.settings.logo_width_mobile }}px;
    --event-heading-size: {{ section.settings.heading_size_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      --event-logo-width: {{ section.settings.logo_width }}px;
      --event-heading-size: {{ section.settings.heading_size }}px;
    }
  }

  {%- if section.settings.hide_site_chrome -%}
    /* Focused landing page: hide the site header, announcement bar, footer,
       breadcrumbs and the sitewide newsletter popup on this template only. */
    .shopify-section-group-header-group,
    .footer-wrapper,
    #breadcrumbs,
    .popup-skin,
    #PopupOverlay {
      display: none !important;
    }
  {%- endif -%}

  .event-signup {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 48px 16px;
    background-color: var(--event-bg);
    color: var(--event-text);
    overflow: hidden;
    isolation: isolate;
  }

  .event-signup__bg,
  .event-signup__bg img,
  .event-signup__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .event-signup__bg { z-index: -2; }
  .event-signup__bg img { object-fit: cover; object-position: center; }
  .event-signup__overlay {
    z-index: -1;
    background-color: var(--event-overlay);
    opacity: var(--event-overlay-opacity);
  }

  .event-signup__inner {
    width: 100%;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .event-signup__logo img {
    display: block;
    width: var(--event-logo-width);
    max-width: 100%;
    height: auto;
  }

  .event-signup__heading {
    margin: 0;
    color: var(--event-text);
    font-size: var(--event-heading-size);
    line-height: 1.05;
  }

  .event-signup__description,
  .event-signup__description p {
    margin: 0;
    color: var(--event-text);
    font-size: 16px;
    line-height: 1.5;
  }

  .event-signup__description p + p { margin-top: 12px; }
  .event-signup__description a { color: inherit; text-decoration: underline; }

  /* Newsletter form, laid out for the landing page (mobile first). */
  .event-signup .newsletter-wrapper--outer {
    display: block;
    width: 100%;
  }

  /* Heading and description are rendered by this section, not the snippet. */
  .event-signup .newsletter-content--wrapper { display: none; }

  .event-signup .newsletter-form--wrapper {
    display: block;
    width: 100%;
  }

  .event-signup .newsletter-form--wrapper form { width: 100%; }

  .event-signup #newsletter-wrapper {
    position: static;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .event-signup #newsletter_text {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    font-size: 16px; /* 16px stops iOS zooming into the field */
    color: var(--event-text);
    background: transparent;
    border: 1px solid var(--event-text);
    border-radius: var(--input-border-radius, 0);
  }

  .event-signup #newsletter_text::placeholder {
    color: var(--event-text);
    opacity: 0.7;
  }

  .event-signup .newsletter-form__button {
    width: 100%;
    min-height: 52px;
    margin: 0;
    white-space: nowrap;
  }

  .event-signup .form-success,
  .event-signup .errors {
    margin: 0;
    color: var(--event-text);
    font-size: 18px;
    line-height: 1.4;
  }

  .event-signup .errors { font-size: 15px; margin-bottom: 12px; }

  .event-signup__fine-print,
  .event-signup__fine-print p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--event-text);
    opacity: 0.75;
  }

  /* Confirmation panel shown after a successful signup */
  .event-signup__inner:has(.event-signup__success) .event-signup__description,
  .event-signup__inner:has(.event-signup__success) .event-signup__fine-print {
    display: none;
  }

  .event-signup__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    outline: none;
  }

  .event-signup__success-heading {
    margin: 0;
    color: var(--event-text);
    font-size: 28px;
    line-height: 1.1;
  }

  .event-signup__success-text {
    margin: 0;
    color: var(--event-text);
    font-size: 16px;
    line-height: 1.5;
  }

  .event-signup__code-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 20px 16px;
    border: 2px dashed var(--event-text);
    border-radius: var(--block-border-radius, 0);
  }

  .event-signup__code-label {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .event-signup__code-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .event-signup__code {
    font-family: var(--header-font-stack);
    font-size: 36px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--event-text);
    user-select: all;
    word-break: break-all;
  }

  .event-signup__copy,
  .event-signup__shop {
    width: 100%;
    min-height: 52px;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (min-width: 600px) {
    .event-signup__code-row { flex-direction: row; justify-content: center; gap: 20px; }
    .event-signup__copy { width: auto; padding: 0 24px; }
    .event-signup__shop { width: auto; padding: 0 32px; }
    .event-signup__success-heading { font-size: 36px; }
    .event-signup__code { font-size: 44px; }
  }

  @media screen and (min-width: 600px) {
    .event-signup #newsletter-wrapper { flex-direction: row; }
    .event-signup #newsletter_text { flex: 1 1 auto; }
    .event-signup .newsletter-form__button { width: auto; flex: 0 0 auto; padding: 0 28px; }
  }

  @media screen and (min-width: 768px) {
    .event-signup { padding: 80px 40px; }
    .event-signup__description,
    .event-signup__description p { font-size: 18px; }
  }
{%- endstyle -%}

<div
  class="event-signup"
  data-wetheme-section-type="event-signup"
  data-wetheme-section-id="{{ section.id }}"
>
  {%- if section.settings.background_image != blank -%}
    <div class="event-signup__bg">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    </div>
    <div class="event-signup__overlay"></div>
  {%- endif -%}

  <div class="event-signup__inner">
    {%- if section.settings.logo != blank -%}
      <div class="event-signup__logo">
        {{
          section.settings.logo
          | image_url: width: 800
          | image_tag:
            widths: '200, 400, 600, 800',
            sizes: logo_sizes,
            loading: 'eager',
            alt: logo_alt
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="event-signup__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="event-signup__description rte">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- render 'newsletter-form',
      section: section,
      form_id: event_form_id,
      tags: event_tags,
      success_message: section.settings.success_message,
      success_content: event_success,
      button_label: section.settings.button_label
    -%}

    {%- if section.settings.fine_print != blank -%}
      <div class="event-signup__fine-print rte">{{ section.settings.fine_print }}</div>
    {%- endif -%}

    {%- if request.design_mode -%}
      <p class="event-signup__fine-print">Editor note: signups are tagged <strong>{{ event_tags }}</strong>.</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('EventSignupSuccess-{{ section.id }}');
    if (!root) return;

    // Bring the confirmation into view after the page reloads from the form post.
    try { root.scrollIntoView({ block: 'center' }); root.focus({ preventScroll: true }); } catch (e) {}

    var button = root.querySelector('[data-event-copy]');
    var codeEl = root.querySelector('[data-event-code]');
    var status = root.querySelector('[data-event-copy-status]');
    if (!button || !codeEl) return;

    var label = button.textContent;

    function copied() {
      button.textContent = button.getAttribute('data-copied-text') || label;
      if (status) status.textContent = button.textContent;
      setTimeout(function () { button.textContent = label; }, 2000);
    }

    function fallback(text) {
      var range = document.createRange();
      range.selectNodeContents(codeEl);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
      try { if (document.execCommand('copy')) copied(); } catch (e) {}
    }

    button.addEventListener('click', function () {
      var text = codeEl.textContent.trim();
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(copied, function () { fallback(text); });
      } else {
        fallback(text);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Event signup",
  "tag": "section",
  "class": "event-signup-section",
  "settings": [
    {
      "type": "header",
      "content": "Signup"
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Customer tags",
      "default": "newsletter,november-2026-event",
      "info": "Comma-separated tags added to each new signup. The customer segment, discount and Klaviyo flow depend on this exact tag, so only change it when reusing this page for a new event."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my code"
    },
    {
      "type": "header",
      "content": "Confirmation (after signup)"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Confirmation heading",
      "default": "You're in!"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Confirmation message",
      "default": "Here's your code for 20% off. We'll also email it to you."
    },
    {
      "type": "checkbox",
      "id": "show_code",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "NOVEVENT20",
      "info": "Must match the discount in Shopify admin exactly. Only customers in the event segment can use it."
    },
    {
      "type": "text",
      "id": "code_label",
      "label": "Code label",
      "default": "Your code"
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy button label",
      "default": "Copy code"
    },
    {
      "type": "text",
      "id": "copied_label",
      "label": "Copied confirmation",
      "default": "Copied!"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "Shop now",
      "info": "Leave empty to hide. The code is applied automatically at checkout."
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop button link",
      "info": "Defaults to all products."
    },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Fine print",
      "info": "Optional small text under the form, for example offer terms."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo width (desktop)",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 140
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Join us in November"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Sign up with your email to get 20% off your first FUTR order.</p>"
    },
    {
      "type": "header",
      "content": "Background and colors"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "2400 x 1600px recommended. Leave empty to use the background color."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0d0d0d"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 50
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Page layout"
    },
    {
      "type": "checkbox",
      "id": "hide_site_chrome",
      "label": "Hide site header, footer and popup",
      "info": "Keeps the landing page focused on the signup form.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Event signup"
    }
  ]
}
{% endschema %}
