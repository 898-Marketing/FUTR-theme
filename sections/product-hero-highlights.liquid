{% comment %}
  Product Hero Highlights — a full-bleed background-image banner with a
  headline, an optional badge image, and a row of highlight cards below.
  Every field (image, badge, heading, card copy, spacing) is editable per
  section instance, so each product page gets its own version.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .phh {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.overlay_color }};
  }
  #shopify-section-{{ section.id }} .phh__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .phh__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  #shopify-section-{{ section.id }} .phh__bg-mobile {
    display: none;
  }
  #shopify-section-{{ section.id }} .phh__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .phh__content {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.content_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .phh__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: {{ section.settings.heading_bottom_spacing }}px;
  }
  #shopify-section-{{ section.id }} .phh__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-family: var(--header-font-stack);
    font-weight: var(--header-font-weight);
    font-size: {{ section.settings.heading_font_size_desktop }}px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 720px;
  }
  #shopify-section-{{ section.id }} .phh__badge {
    flex: 0 0 auto;
    width: {{ section.settings.badge_size }}px;
    height: {{ section.settings.badge_size }}px;
  }
  #shopify-section-{{ section.id }} .phh__badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ section.id }} .phh__top--badge-left {
    flex-direction: row-reverse;
  }
  #shopify-section-{{ section.id }} .phh__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
  }
  #shopify-section-{{ section.id }} .phh__card {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 12px;
    padding: {{ section.settings.card_padding }}px;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .phh__card-heading {
    margin: 0 0 10px;
    color: {{ section.settings.card_heading_color }};
    font-family: var(--header-font-stack);
    font-weight: var(--header-font-weight);
    font-size: 18px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .phh__card-text {
    margin: 0;
    color: {{ section.settings.card_text_color }};
    font-family: var(--body-font-stack);
    font-size: 15px;
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .phh__card-text p {
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .phh__bg-desktop {
      display: none;
    }
    #shopify-section-{{ section.id }} .phh__bg-mobile {
      display: block;
    }
    #shopify-section-{{ section.id }} .phh__content {
      padding: {{ section.settings.section_padding_top_mobile }}px {{ section.settings.content_padding_horizontal_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .phh__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
      max-width: 100%;
    }
    #shopify-section-{{ section.id }} .phh__badge {
      width: {{ section.settings.badge_size_mobile }}px;
      height: {{ section.settings.badge_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .phh__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="phh" data-wetheme-section-type="product-hero-highlights" data-wetheme-section-id="{{ section.id }}">
  <div class="phh__bg">
    {% if section.settings.image_desktop %}
      <img class="phh__bg-desktop" src="{{ section.settings.image_desktop | image_url: width: 2000 }}" alt="" loading="eager">
    {% endif %}
    {% if section.settings.image_mobile %}
      <img class="phh__bg-mobile" src="{{ section.settings.image_mobile | image_url: width: 1200 }}" alt="" loading="eager">
    {% elsif section.settings.image_desktop %}
      <img class="phh__bg-mobile" src="{{ section.settings.image_desktop | image_url: width: 1200 }}" alt="" loading="eager">
    {% endif %}
  </div>
  <div class="phh__overlay"></div>

  <div class="phh__content">
    <div class="phh__top{% if section.settings.badge_position == 'top_left' %} phh__top--badge-left{% endif %}">
      {% if section.settings.heading != blank %}
        <h2 class="phh__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.badge_image %}
        <div class="phh__badge">
          {{ section.settings.badge_image | image_url: width: 400 | image_tag: alt: section.settings.badge_alt, loading: 'lazy' }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="phh__grid">
        {% for block in section.blocks %}
          <div class="phh__card" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h3 class="phh__card-heading">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="phh__card-text">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Hero Highlights",
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Leave blank to reuse the desktop image."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#0a1420"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The first true pregame for youth sports."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 18,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Badge image"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image",
      "info": "e.g. a \"Specifically made for youth sports\" seal. Leave blank to hide it."
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge alt text",
      "info": "Describe the badge for accessibility and SEO."
    },
    {
      "type": "select",
      "id": "badge_position",
      "label": "Badge position",
      "default": "top_right",
      "options": [
        { "value": "top_right", "label": "Top right" },
        { "value": "top_left", "label": "Top left" }
      ]
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge size (desktop)",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "label": "Badge size (mobile)",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 90
    },
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "content_padding_horizontal",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_horizontal_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Space below heading row",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Card colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#16305c"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#4a90d9"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#dbe6f2"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feel physically ready"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Describe the benefit here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hero Highlights",
      "blocks": [
        { "type": "highlight" },
        { "type": "highlight" },
        { "type": "highlight" }
      ]
    }
  ]
}
{% endschema %}
