{%- comment -%} Price can be hidden for Coming Soon products (Theme settings > Coming Soon > Hide price) {%- endcomment -%}
{%- capture is_coming_soon -%}{%- render 'coming-soon-check', product: current_variant.product -%}{%- endcapture -%}
{%- unless is_coming_soon == 'true' and settings.coming_soon_hide_price -%}
{% liquid 
  if settings.show_currency_code
    assign current_variant_price = current_variant.price | money_with_currency
  else 
    assign current_variant_price = current_variant.price | money
  endif
%}

<span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
<span 
  data-product-price id="ProductPrice" itemprop="price"
  content="{{ current_variant.price | divided_by: 100 }}"
>
  {% unless current_variant %}
    {{ 'products.product.unavailable' | t }}
  {% else %}
    <span 
      data-price-text data-unavailable-text="{{ 'products.product.unavailable' | t }}" 
      class="money"
    >
      {{ current_variant_price }}
    </span>
  {% endunless %}
</span>
{%- endunless -%}
