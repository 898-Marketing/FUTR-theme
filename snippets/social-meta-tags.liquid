<!-- /snippets/social-meta-tags.liquid -->
{%- assign og_title = page_title -%}
{%- assign og_url = canonical_url -%}
{%- assign og_type = 'website' -%}
{%- assign og_description = page_description | default: shop.description | default: shop.name -%}

{%- comment -%} page_image is the Preferences "Social sharing image"; skip the tags when none is set (it used to print a Liquid error). {%- endcomment -%}
{%- assign og_image_alt_tags = '' -%}
{%- assign og_image_tags = '' -%}
{%- assign og_image_secure_url_tags = '' -%}
{%- if page_image -%}
  {%- capture og_image_alt_tags -%}<meta property="og:image:alt" content="{{ shop.name | escape }}">{%- endcapture -%}
  {%- capture og_image_tags -%}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endcapture -%}
  {%- capture og_image_secure_url_tags -%}<meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">{%- endcapture -%}
{%- endif -%}

{% comment %} Template specific overides {% endcomment %}
{% if request.page_type == 'product' %}
  {%- assign og_title = product.title | strip_html -%}
  {%- assign og_type = 'product' -%}
  {% if product.media.size > 0 %}
    {%- capture og_image_alt_tags -%}{% for media in product.media limit: 3 -%}<meta property="og:image:alt" content="{{ media.alt }}">{% endfor -%}{%- endcapture -%}
    {%- capture og_image_tags -%}{% for media in product.media limit: 3 -%}<meta property="og:image" content="https:{{ media | image_url }}">{% endfor -%}{% endcapture -%}
    {%- capture og_image_secure_url_tags -%}{% for media in product.media limit: 3 -%}<meta property="og:image:secure_url" content="https:{{ media | image_url }}">{% endfor -%}{% endcapture -%}
  {% endif %}

{% elsif request.page_type == 'article' %}
  {%- assign og_title = article.title | strip_html -%}
  {%- assign og_type = 'article' -%}
  {%- assign og_description = article.excerpt_or_content | strip_html -%}
  {% if article.image %}
    {%- capture og_image_alt_tags -%}<meta property="og:image:alt" content="{{ article.image.alt }}">{%- endcapture -%}
    {%- capture og_image_tags -%}<meta property="og:image" content="https:{{ article.image | image_url }}">{%- endcapture -%}
    {%- capture og_image_secure_url_tags -%}<meta property="og:image:secure_url" content="https:{{ article.image | image_url }}">{%- endcapture -%}
  {% endif %}

{% elsif request.page_type == 'collection' %}
  {%- assign og_title = collection.title | strip_html -%}
  {%- assign og_type = 'product.group' -%}
  {% if collection.image %}
    {%- capture og_image_alt_tags -%}<meta property="og:image:alt" content="{{ collection.image.alt }}">{%- endcapture -%}
    {%- capture og_image_tags -%}<meta property="og:image" content="https:{{ collection.image | image_url }}">{%- endcapture -%}
    {%- capture og_image_secure_url_tags -%}<meta property="og:image:secure_url" content="https:{{ collection.image | image_url }}">{%- endcapture -%}
  {% endif %}

{% elsif request.page_type == 'password' %}
  {%- assign og_title = shop.name -%}
  {%- assign og_url = shop.url -%}
  {%- assign og_description = shop.description | default: shop.name -%}
{% endif %}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{% if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{% endif %}
{{ og_image_tags }}
{{ og_image_alt_tags }}
{{ og_image_secure_url_tags }}

{% unless settings.sm_x_link == blank %}
  <meta name="twitter:site" content="{{ settings.sm_x_link | split: 'x.com/' | last | prepend: '@' }}">
{% endunless %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
