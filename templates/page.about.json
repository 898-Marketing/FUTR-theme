    "template_product_info_columns_NzhHxq": {
      "type": "template--product--info-columns",
      "blocks": {
        "image_and_text_d7H3Dm": {
          "type": "image_and_text",
          "settings": {
            "grid_image_size": "square",
            "heading": "SUZANNE GATT",
            "text": "<p>Founder, CEO</p>",
            "bio_text": "<p>I’m a mom, coach, and 13+ year sports nutrition industry veteran with a career spent building brands, developing products, and bringing sports nutrition to athletes at the highest level.</p><p><strong>But FUTR started with something much more personal.</strong></p><p>For years, parents would ask me the same question: “What can I give my kid?” And despite spending my career inside the sports nutrition industry, I never had an answer I felt great about.</p><p>There were plenty of products for adults. But when it came to young athletes, I kept seeing the same thing: products that weren’t really designed for them, adult formulas repackaged for a younger audience, or options that simply didn’t reflect how kids actually train, play, recover, and grow.</p><p><strong>I knew we could do better. So I decided to build it.</strong></p><p>Over the course of my career, I’ve had the opportunity to work alongside some of the best people in sports nutrition — formulators, researchers, flavor scientists, manufacturers, testing labs, retailers, and industry employees. I’ve seen firsthand what it takes to create great products, but I’ve also learned where shortcuts can happen and which details matter most.</p><p><strong>That means asking harder questions. </strong>Being able to explain why an ingredient is there and why we use the amount we do. Surrounding myself with experts who know more than I do in their respective fields. Choosing partners I trust. And never making a decision simply because it is easier, faster, or looks better on a label.</p><p>I’m still a parent reading the back of the package. I’m still a coach standing on the sideline. And I’m also someone who has spent most of my career building products in this industry.</p><p>FUTR is where all three of those parts of my life came together.</p><p><strong>This one is personal.</strong></p>",
            "button_link": "",
            "button_text": ""
          }
        },
        "image_and_text_CjEQAK": {
          "type": "image_and_text",
          "settings": {
            "grid_image_size": "square",
            "heading": "RAUL PUJOL",
            "text": "<p>Chief Business Development <br/>& Partnerships Officer  </p>",
