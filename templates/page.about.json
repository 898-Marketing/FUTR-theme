        "richtext_4YaFct": {
          "type": "richtext",
          "settings": {
            "text": "<p>FUTR was built on a simple belief: every growing athlete deserves nutrition made specifically for them. Not borrowed from adult formulas. Not watered down.&nbsp;</p><p>Every product is developed around the way young athletes actually train, compete, recover, and grow — purposeful and science-backed.</p>",
            "text_size": 22,
            "text_bottom_spacing": 20
          }
        }
