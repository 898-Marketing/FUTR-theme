          }
        },
        "richtext_4YaFct": {
          "type": "richtext",
          "settings": {
            "text": "<p>FUTR was built on a simple belief: every growing athlete deserves nutrition made specifically for them.<br/>Not borrowed from adult formulas. Not watered down. Every product is engineered around the way young athletes actually train, compete, recover, and grow — safe, purposeful, and science-backed.<br/>This is nutrition built for the stage of the game they're in right now.<br/></p>",
